
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
        // Custom claim is the source of truth (see scripts/set-admin-claim.js).
        // The hardcoded UIDs/emails are carried over from lawslane-admin's rules
        // as a safety net during rules consolidation — remove once every admin
        // account is confirmed to have the custom claim set (see LAWSLANE-PLAN-01 Phase 4).
        return isSignedIn() && (
          request.auth.token.admin == true ||
          request.auth.uid == 'wS9w7ysNYUajNsBYZ6C7n2Afe9H3' ||
          request.auth.token.email == 'lek.26015@gmail.com' ||
          request.auth.uid == '6rX3WqjNo9M7lX6iUe5V9r7Dk9z1' ||
          request.auth.token.email == 'admin@lawslane.com'
        );
    }

    match /users/{userId} {
      // เดิมเป็น denylist (ห้าม role / companyId / ฯลฯ) แต่ denylist รั่วทุกครั้งที่มีฟิลด์สิทธิ์ใหม่
      // (เช่น status ที่แอดมินใช้ระงับบัญชี, lineUserId ที่ api/auth/line ใช้หาเจ้าของบัญชีตอนล็อกอิน
      //  ด้วย LINE, lawyer / admin ที่หน้าตาเหมือน custom claim) จึงกลับด้านเป็น allowlist
      // เฉพาะฟิลด์ที่ client เขียนจริง
      //
      // ไล่ดูทุก repo ที่ใช้ Firebase project นี้แล้ว (Lawslane, admin, capdeal, business,
      // business-landing, lawlanes-education, lawslane-education) client เขียน users/{ตัวเอง}:
      //   create — signup-content / login-content (Google) / lawyer-signup / for-lawyers /
      //            account (กรณีไม่มีเอกสาร) / chat/[id] (auto-repair) / education signup+login:
      //            uid name email phone role type status avatar termsAccepted termsAcceptedAt
      //            registeredAt createdAt updatedAt
      //   update — account: name avatar updatedAt | client-provider heartbeat: lastActive
      //            capdeal login: avatar updatedAt | chat auto-repair (merge): uid name email
      //            role status createdAt (ค่าเดิม → ไม่นับเป็นการเปลี่ยน ยกเว้น createdAt)
      //            business settings/profile: companyName taxId address phone website updatedAt
      //            business-landing subscribe: plan billingCycle subscriptionStatus paymentMethod
      //            companyName companyBranch companyAddress taxId updatedAt
      //            (⚠️ subscriptionStatus คุมการเข้าหน้า B2B แต่หน้า subscribe ยัง "จำลองการจ่ายเงิน"
      //             ฝั่ง client อยู่ — ถ้าปิดตรงนี้การสมัครแพ็กเกจพังทั้งหมด ค้างไว้เป็น follow-up
      //             ให้ย้ายไป server พร้อมระบบจ่ายเงินจริง)
      //
      // ที่เหลือ — role, status (ระงับบัญชี), companyId, superAdmin/permissions/adminPermissions,
      // lineUserId/lineDisplayName/linePictureUrl, subscription/balance/credits, verified,
      // notificationPreferences ฯลฯ — เขียนผ่าน Admin SDK หรือแอดมินเท่านั้น
      // (admin-notify / admin-notifications อ่าน users where role == 'admin' เพื่อหาผู้รับแจ้งเตือน
      //  และ canAccessContract() / canAccessCompliance() ด้านล่างเชื่อ companyId)
      function ownerCreatableUserFields() {
        return [
          'uid', 'name', 'email', 'phone', 'role', 'type', 'status', 'avatar',
          'termsAccepted', 'termsAcceptedAt', 'registeredAt', 'createdAt', 'updatedAt'
        ];
      }

      function ownerUpdatableUserFields() {
        return [
          'name', 'avatar', 'phone', 'updatedAt', 'lastActive', 'createdAt',
          // B2B (lawslane-business settings/profile, business-landing subscribe)
          'companyName', 'companyBranch', 'companyAddress', 'taxId', 'address', 'website',
          'plan', 'billingCycle', 'subscriptionStatus', 'paymentMethod'
        ];
      }

      // ตอนสมัครสมาชิก ฝั่ง client เขียน role มาด้วย (signup-content.tsx, lawyer-signup, education)
      // จึงอนุญาตเฉพาะค่าที่ไม่ใช่สิทธิ์พิเศษ — ห้าม 'admin' เด็ดขาด
      // (business-landing subscribe เขียน role: 'admin' ตอนสร้างบัญชี → โดนปฏิเสธมาตั้งแต่รอบก่อน
      //  ดู follow-up ใน PR)
      function createsSafeRole() {
        return !('role' in request.resource.data.keys())
          || request.resource.data.role in ['customer', 'lawyer', 'education_student'];
      }

      // status ตอนสร้าง: 'active' (ลูกค้า / for-lawyers / education) หรือ 'pending' (lawyer-signup)
      // ห้ามสร้างมาเป็น 'approved' เอง — การอนุมัติทนายทำผ่าน Admin SDK
      function createsSafeStatus() {
        return !('status' in request.resource.data.keys())
          || request.resource.data.status in ['active', 'pending'];
      }

      function createsOwnUid() {
        return !('uid' in request.resource.data.keys())
          || request.resource.data.uid == userId;
      }

      allow read: if isSignedIn();

      allow create: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.keys().hasOnly(ownerCreatableUserFields())
            && createsSafeRole()
            && createsSafeStatus()
            && createsOwnUid());

      // อัปเดตโปรไฟล์ของตัวเองได้เฉพาะฟิลด์ในลิสต์ — การเปลี่ยน role / status / companyId /
      // lineUserId ต้องทำผ่าน Admin SDK ฝั่ง server หรือแอดมินเท่านั้น
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(ownerUpdatableUserFields()));

      allow delete: if isAdmin();

      match /integrations/{integrationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /lawyerProfiles/{lawyerId} {
      // เดิมเป็น `allow read, list: if true` — ใครก็ยิง list ครั้งเดียวแล้วได้
      // phone, email, address, dob, lineId, bankName, bankAccountNumber,
      // idCardUrl, licenseUrl ของทนาย "ทุกคน" ในระบบ (การ strip ฟิลด์ใน
      // src/lib/data.ts เป็นแค่เครื่องสำอาง เพราะรันบน client SDK)
      //
      // ตอนนี้: ปิดการดึงเป็นชุด — ไดเรกทอรี หน้าแรก หน้าตรวจใบอนุญาต และหน้า
      // สำนักงานกฎหมาย อ่านผ่าน server action ที่ใช้ Admin SDK + projection
      // สาธารณะแทน (src/app/actions/lawyer-directory-actions.ts)
      //
      // การอ่านทีละคนใน repo นี้ย้ายเป็น server action ครบแล้ว (getPublicLawyerAction /
      // getChatLawyerAction / getMyLawyerProfileAction) ที่ยังยิง client SDK เหลือแค่
      // เจ้าของอ่านเอกสารของตัวเองด้วย uid (header, account, financials)
      //
      // ⚠️ `get` ยังต้องเปิดสาธารณะไว้ก่อน เพราะ repo อื่นที่ใช้ Firestore ชุดนี้ร่วมกัน
      // ยัง getDoc โปรไฟล์ทนายคนอื่นจาก browser อยู่ (lawslane-capdeal: invoice/[id],
      // payment, review ผ่าน getLawyerById) — ปิดตอนนี้หน้าพวกนั้นพังทันที
      // เป้าหมายหลังย้ายครบ: get ได้เฉพาะเจ้าของ (lawyerId == uid หรือ
      // resource.data.userId == uid) หรือแอดมิน
      allow get: if true;
      // list: แอดมิน หรือ query ที่ผูกกับตัวเองเท่านั้น (where userId == uid)
      // rules บังคับว่า query ต้องมีเงื่อนไขนี้ จึงไล่ดึงของคนอื่นไม่ได้ — คงไว้ให้
      // flow "บัญชีนี้เป็นทนายไหม" ใน repo อื่น (เช่น lawslane-capdeal payment) ยังทำงาน
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // เดิม create เช็คแค่ userId == uid (doc id อะไรก็ได้) และ update ให้เจ้าของแก้ได้ทุกฟิลด์
      // → ทนายตั้ง status: 'approved' ให้ตัวเอง (อนุมัติตัวเองโดยไม่ผ่านแอดมิน), ตั้ง
      //   platformFeeRate: 0 / pricing / averageRating / reviewCount / rank ได้เอง
      // → สร้างโปรไฟล์ที่ doc id ไม่ใช่ uid ตัวเองได้หลายใบ (requireLawyer() หาโปรไฟล์จาก userId)
      //
      // ไล่ดูทุก repo แล้ว client สร้างโปรไฟล์ที่ lawyerProfiles/{uid ตัวเอง} จากหน้าสมัครเท่านั้น
      // (lawyer-signup ใน Lawslane/admin/business/business-landing, for-lawyers ใน Lawslane/
      //  business-landing) ด้วยฟิลด์ข้างล่าง และสถานะ 'pending' เสมอ — การอนุมัติอัตโนมัติจาก
      // ทะเบียนทนายย้ายไป autoApproveLawyerFromRegistryAction (Admin SDK) แล้ว
      function signupLawyerFields() {
        return [
          'userId', 'name', 'email', 'phone', 'dob', 'gender', 'education', 'experience',
          'licenseNumber', 'address', 'serviceProvinces', 'specialty', 'description',
          'bankName', 'bankAccountName', 'bankAccountNumber', 'lineId',
          'imageUrl', 'imageHint', 'idCardUrl', 'licenseUrl', 'status', 'joinedAt'
        ];
      }

      // ฟิลด์ที่ทนายแก้เองได้จาก client:
      //   account/page.tsx (Lawslane, capdeal): name phone licenseNumber address bankName
      //     bankAccountName bankAccountNumber serviceProvinces specialty description updatedAt imageUrl
      //   lawyer-dashboard/financials (Lawslane, admin, business, business-landing):
      //     bankName bankAccountNumber bankAccountName corporateName corporateTaxId corporateAddress
      // ⚠️ บัญชีธนาคารยังแก้จาก client ได้ เพราะหน้า financials ของทุก repo เขียนตรง — ปลายทาง
      //    เงินถอนผูกกับฟิลด์นี้ ควรย้ายไป server action ที่ยืนยันตัวตนซ้ำ (follow-up)
      //
      // ห้ามแตะ: status / approvedAt / approvedBy / rejectionReason (การอนุมัติ), userId,
      // idCardUrl / licenseUrl (เอกสารที่แอดมินตรวจแล้ว), pricing (updateLawyerPricingAction),
      // platformFeeRate / gp* (แอดมินกำหนด), averageRating / reviewCount (submitReviewAction),
      // rank.*, schedule (updateLawyerScheduleAction) — ทั้งหมดเขียนผ่าน Admin SDK
      function ownerEditableLawyerFields() {
        return [
          'name', 'phone', 'address', 'serviceProvinces', 'specialty', 'description',
          'imageUrl', 'updatedAt',
          'bankName', 'bankAccountName', 'bankAccountNumber',
          'corporateName', 'corporateTaxId', 'corporateAddress'
        ];
      }

      // เลขใบอนุญาตแก้ได้เฉพาะก่อนผ่านการอนุมัติ (ยังรอตรวจ / ถูกปฏิเสธแล้วแก้ส่งใหม่)
      // อนุมัติแล้วเปลี่ยนเองได้ = ผ่านการตรวจด้วยเลขจริงแล้วสลับเป็นเลขคนอื่น
      function licenseStillEditable() {
        return resource.data.get('status', 'pending') in ['pending', 'rejected'];
      }

      allow create: if isAdmin() || (
        isOwner(lawyerId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(signupLawyerFields())
      );

      allow update: if isAdmin() || (
        isOwner(lawyerId)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerEditableLawyerFields())
          || (licenseStillEditable()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(ownerEditableLawyerFields().concat(['licenseNumber'])))
        )
      );
      allow delete: if isOwner(lawyerId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // รีวิวสร้างผ่าน submitReviewAction (Admin SDK) เท่านั้น — action นั้นตรวจว่าผู้รีวิวเป็นลูกความ
      // ของเคสจริง, เคสจบแล้ว, รีวิวได้ครั้งเดียว แล้วคำนวณ averageRating / reviewCount ใหม่
      // เดิม client สร้างเองได้แค่ใส่ userId ตัวเอง → ปั่นรีวิว 5 ดาว/1 ดาวให้ทนายคนไหนก็ได้
      // โดยไม่เคยมีเคส และแก้/ลบรีวิวเองได้ทำให้ตัวเลขเฉลี่ยในโปรไฟล์เพี้ยน
      // ไล่ดูทุก repo แล้วไม่มี client ตัวไหนเขียน reviews (หน้า chat/[id], review/[id] เรียก action)
      allow create, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      
      allow get: if isSignedIn() && (isParticipant() || isAdmin()); 
      allow list: if isSignedIn() && (
        (request.query.limit <= 1000 && request.auth.uid in request.query.filters.participants) || 
        isAdmin()
      ); 
      // เดิม `allow create: if isSignedIn()` → เปิด console ยิง SDK สร้างเคสพร้อม
      // `amount: 50000, status: 'paid'` ได้โดยไม่ต้องจ่ายอะไรเลย ทนายเห็นว่าเคส
      // จ่ายแล้วและลงมือทำงานฟรี
      //
      // ตอนนี้ทุกห้องสร้างผ่าน Admin SDK: createConsultationChat() (Lawslane, capdeal)
      // และ respondToAppointmentRequestAction() (Lawslane) ไล่ดูทุก repo ที่ใช้
      // Firebase project นี้แล้ว ไม่มี client ตัวไหนสร้าง chats เหลือ
      // (ensureChatExists ใน chat-box.tsx และหน้ารับเคสของ repo สำเนาถูกถอดแล้ว)
      allow create: if isAdmin();

      // ฟิลด์ที่ participant แก้เองได้ — allowlist ไม่ใช่ denylist
      // เดิมกฎเป็น `isParticipant()` เฉยๆ → updateDoc(chats/{id}, { status: 'active',
      // paidAmount: 50000 }) กับห้องที่ตัวเองอยู่ได้ รอบก่อนเปลี่ยนเป็น denylist ฟิลด์เงิน
      // แต่ denylist รั่วทุกครั้งที่มีคนเพิ่มฟิลด์เงินใหม่ (เช่น additionalFeeRequest,
      // pendingPaymentDetails_installment_N, isManualCase ไม่อยู่ในลิสต์) จึงกลับด้าน
      // เป็นอนุญาตเฉพาะที่ client เขียนจริง
      //
      // ไล่ดูทุก repo ที่ใช้ Firebase project นี้แล้ว (Lawslane, capdeal, business,
      // business-landing, admin) client แก้เอกสาร chats แค่:
      //   - lastMessage / lastMessageAt / hasNewMessage / lawyerReadAt  (chat-box.tsx)
      //   - files (arrayUnion ตอนอัปโหลดไฟล์ — Lawslane chat/[id]/page.tsx)
      // ที่เหลือ (สถานะ ยอด งวด คำขอค่าบริการ สลิป ผู้เข้าร่วม) เขียนผ่าน Admin SDK ทั้งหมด
      function participantWritableChatFields() {
        return ['lastMessage', 'lastMessageAt', 'hasNewMessage', 'lawyerReadAt', 'files'];
      }

      allow update: if isAdmin() || (
        isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(participantWritableChatFields())
      );

      match /messages/{messageId} {
        function isChatParticipant() {
          return exists(/databases/$(database)/documents/chats/$(chatId)) &&
                 request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow get, list: if isChatParticipant() || isAdmin();
        // เดิมเช็คแค่ senderId == uid ของตัวเอง แต่ไม่ได้เรียก isChatParticipant()
        // (นิยามไว้ข้างบนแต่ใช้แค่ตอนอ่าน) → รู้ chatId ก็แทรกข้อความเข้าแชทคนอื่นได้
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isChatParticipant() || isAdmin());
        allow update, delete: if false;
      }
    }
    
    match /articles/{articleId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /articleComments/{commentId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // แก้ได้แต่ห้ามเปลี่ยน userId (เดิมเปลี่ยนเจ้าของคอมเมนต์เป็นคนอื่นได้ = สวมชื่อ)
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ads/{adId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
        // เดิม `allow create: if isSignedIn()` → ใครก็เปิด console ยิง SDK สร้าง
        // นัดหมายพร้อม `amount: 0, status: 'paid'` ได้โดยไม่ต้องผ่านหน้าเว็บ
        // ทนายก็เห็นว่าจ่ายแล้วและลงมือทำงานฟรี
        //
        // ตอนนี้นัดหมายสร้างผ่าน createAppointment() ฝั่ง server ทั้งใน Lawslane
        // และ lawslane-capdeal ซึ่งคิดยอดใหม่เองและตั้งสถานะจากผลตรวจสลิปจริง
        // (ไล่ดูแล้วว่าไม่มี client ตัวไหนเหลือสร้าง appointments อีก — repo อื่น
        //  แตะแค่ update สถานะของนัดหมายที่มีอยู่)
        allow create: if isAdmin();
        // Allow read if user is involved or admin
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.lawyerId == request.auth.uid
            || resource.data.get('lawyerUserId', '') == request.auth.uid || isAdmin());
        // Allow list only if the query is properly filtered by the user's role/id
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && (request.auth.uid in request.query.filters.userId || request.auth.uid in request.query.filters.lawyerId)) ||
          isAdmin()
        );
        // เดิมเจ้าของ/ทนายแก้ได้ทุกฟิลด์ → updateDoc(appointments/{id}, { status: 'paid' })
        // ข้ามการตรวจสลิป หรือแก้ amount / lawyerId / slipOkData ได้เอง
        //
        // ไล่ดูทุก repo แล้ว client เขียน appointments อยู่ที่เดียว: ปุ่ม "ปฏิเสธเคส" ใน
        // lawyer-dashboard/request/[id] ของ business / business-landing / admin ซึ่งตั้ง
        // { status: 'cancelled', updatedAt } เท่านั้น — การรับเคส (confirmed + chatId)
        // และการอนุมัติสลิป (paid) ทำผ่าน Admin SDK (respondToAppointmentRequestAction,
        // createAppointment, approvePaymentSlipAction)
        //
        // จึงเหลือแค่ "ยกเลิก" จากสถานะที่ยังไม่ได้รับเคส — ห้ามยกเลิกนัดที่รับไปแล้ว
        // (มีห้องแชทผูกอยู่) และห้ามเปลี่ยนเป็นสถานะอื่นใดทั้งสิ้น
        allow update: if isAdmin() || (
          isSignedIn()
          && (resource.data.userId == request.auth.uid || resource.data.lawyerId == request.auth.uid
              || resource.data.get('lawyerUserId', '') == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
          && resource.data.get('status', 'pending') in ['pending', 'pending_payment', 'paid']
        );
    }

    match /tickets/{ticketId} {
        // เดิม create: isSignedIn() เฉยๆ → สร้างตั๋วในชื่อ userId คนอื่น หรือสร้างมาเป็น status อะไรก็ได้
        // และ update ให้เจ้าของแก้ได้ทุกฟิลด์ (เช่น ปิดตั๋ว/เปลี่ยนสถานะที่แอดมินใช้คัดงานเอง)
        // client เขียน tickets แค่: help/page.tsx (Lawslane, capdeal) สร้างตั๋ว status 'pending'
        // และ support/[id] (Lawslane) arrayUnion 'files' ตอนแนบไฟล์ — ที่เหลือแอดมินทำ
        allow create: if isAdmin() || (
          isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(
               ['userId', 'caseId', 'problemType', 'description', 'status', 'reportedAt', 'clientName', 'email'])
        );
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.userId) ||
          isAdmin()
        );
        allow update: if isAdmin() || (
          isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files'])
        );

        match /messages/{messageId} {
            allow read, list: if isAdmin() || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId);
            // เดิมเป็น isSignedIn() เฉยๆ → ใครก็ตอบเข้าตั๋วซัพพอร์ตของคนอื่นได้
            // ผู้ใช้ส่งข้อความในนามตัวเองเท่านั้น และ role ต้องเป็น 'user' — support-chat-box.tsx
            // แสดงข้อความ role: 'admin' เป็นคำตอบจากทีมงาน เดิมเจ้าของตั๋วใส่ role: 'admin' เองได้
            allow create: if isAdmin()
              || (isSignedIn()
                  && request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId
                  && request.resource.data.senderId == request.auth.uid
                  && request.resource.data.get('role', 'user') == 'user');
        }
    }

    // ผลตรวจสลิปจาก SlipOK ที่ server เก็บไว้ (ดู api/verify-slip/route.ts)
    // เป็นหลักฐานว่า "จ่ายจริงแล้ว" client ห้ามอ่านหรือเขียนทั้งหมด — เขียนและ
    // ใช้ผ่าน Admin SDK เท่านั้น ไม่งั้นก็ปลอมเอกสารแล้วอ้างว่าจ่ายแล้วได้เหมือนเดิม
    match /slipVerifications/{verificationId} {
        allow read, write: if isAdmin();
    }

    // สลิปที่ถูกใช้ชำระเงินไปแล้ว (doc id มาจาก transRef ของ SlipOK) — จองใน
    // transaction เดียวกับการใช้ตั๋ว (lib/slip-verification.ts) เพื่อให้สลิปโอนจริง
    // ใบเดียวแลกเป็นรายการ "จ่ายแล้ว" ได้ครั้งเดียว ถ้า client เขียน/ลบได้ก็ปลดล็อก
    // สลิปเก่ามาใช้ซ้ำได้ จึงเขียนผ่าน Admin SDK เท่านั้น
    match /slipTransRefs/{transRefId} {
        allow read, write: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
        // เส้นทางเดียวในระบบที่เงินสดออกจากบริษัทจริง — เขียนผ่าน Admin SDK เท่านั้น
        //
        // กฎเดิมคือ `allow create: if isSignedIn() && lawyerId == request.auth.uid`
        // ซึ่งตรวจแค่ว่าเป็นเจ้าของ **ไม่ตรวจยอดเลย** การตรวจยอดอยู่ในเบราว์เซอร์
        // (`amount > stats.availableBalance`) อย่างเดียว → ทนายที่มีรายได้ ฿0
        // เปิด console ยิง SDK ขอถอน ฿500,000 ได้ทันที
        //
        // ตอนนี้คำร้องสร้างผ่าน requestWithdrawal() (Lawslane/src/app/actions/
        // withdrawal-actions.ts) ที่คิดยอดใหม่ฝั่ง server และการอนุมัติผ่าน
        // processWithdrawal() (lawslane-admin) ที่คิดซ้ำก่อนเปลี่ยนสถานะ
        // ไม่มี client ตัวไหนต้องเขียนคอลเลกชันนี้อีกแล้ว
        allow create, update, delete: if isAdmin();
        allow get: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.lawyerId) ||
          isAdmin()
        );
    }

    match /sme_inquiries/{inquiryId} {
        // ไม่มี repo ไหนเขียนคอลเลกชันนี้แล้ว (ฟอร์ม SME ไปเขียน smeRequests) — เดิมเปิด create: if true
        allow create: if isAdmin();
        allow read, update, delete: if isAdmin();
    }

    match /email_logs/{logId} {
        allow read, write: if isAdmin();
    }
    match /notifications/{notificationId} {
        allow create: if isSignedIn();
        allow get: if isSignedIn() && (resource.data.recipient == request.auth.uid || resource.data.recipient == 'admin' || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.recipient == request.auth.uid ||
          (resource.data.recipient == 'admin' && isAdmin()) ||
          isAdmin()
        );
        // ผู้รับแก้ได้แค่สถานะอ่านแล้ว (notification-bell / use-notifications เขียน { read: true })
        // เดิมแก้ได้ทุกฟิลด์ รวมถึง recipient / link / message
        allow update: if isAdmin() || (
          isSignedIn()
          && resource.data.recipient == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        );
    }
    match /landingPages/{pageId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }
    
    match /verifiedLawyers/{lawyerId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /siteContent/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // ─── ฟอร์มสาธารณะ ─────────────────────────────────────────────
    // เดิมทุกตัวเป็น `create: if true` = ไม่ต้องล็อกอิน เขียนเอกสารหน้าตาอะไรก็ได้ ขนาดเท่าไหร่ก็ได้
    // (ฟอร์มที่มี server action คุม rate limit ก็ถูกข้ามได้ด้วยการยิง SDK ตรง)
    // ตัวที่มี writer เป็น server action อย่างเดียว → ปิด create (Admin SDK ข้าม rules อยู่แล้ว)
    // ตัวที่ยังมี repo อื่นเขียนตรงจาก client → allowlist ฟิลด์ + จำกัดขนาด + บังคับสถานะเริ่มต้น

    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    // ไม่มี client ตัวไหนเขียน (แอดมินอ่าน/เปลี่ยนสถานะอย่างเดียว)
    match /contractRequests/{requestId} {
        allow create: if isAdmin();
        allow read, update, delete: if isAdmin();
    }

    // เขียนผ่าน submitRegistrationRequestAction (form-actions.ts, Admin SDK) เท่านั้น
    match /registrationRequests/{requestId} {
        allow create: if isAdmin();
        allow read, update, delete: if isAdmin();
    }

    // Lawslane เขียนผ่าน submitSmeRequestAction (Admin SDK) แต่ sme-contact-form.tsx ใน admin /
    // capdeal / business / business-landing ยัง addDoc ตรงจาก client (ไม่ล็อกอิน) ด้วยฟิลด์
    // name phone email serviceType fileUrl fileName status:'new' createdAt → เปิดเฉพาะรูปร่างนี้
    match /smeRequests/{requestId} {
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(
            ['name', 'phone', 'email', 'serviceType', 'fileUrl', 'fileName', 'status', 'createdAt'])
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
          && isShortString(request.resource.data.name, 200)
          && isShortString(request.resource.data.phone, 50)
          && isShortString(request.resource.data.email, 254)
          && isShortString(request.resource.data.serviceType, 100)
          && isShortString(request.resource.data.get('fileUrl', ''), 1000)
          && isShortString(request.resource.data.get('fileName', ''), 300)
        );
        allow read, update, delete: if isAdmin();
    }

    match /legalForms/{formId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // ตัวนับดาวน์โหลด (incrementFormDownloads → increment(1)) — เดิมเขียนค่าอะไรก็ได้โดยไม่ต้องล็อกอิน
      // ตอนนี้บังคับให้เพิ่มทีละ 1 เท่านั้น
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads == resource.data.get('downloads', 0) + 1
      );
    }

    match /settings/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // เดิม `allow read, list: if true` → ใครก็กวาดโค้ดส่วนลดทุกใบพร้อมส่วนลดได้
      //
      // หน้า payment ตรวจคูปองฝั่ง client ด้วย
      //   where('code','==',X) + where('isActive','==',true) + limit(1)
      // จึงยังต้องให้ query ได้ แต่บังคับ limit <= 1 เพื่อให้ "ต้องรู้โค้ดก่อน"
      // ไล่ดึงรายการทั้งหมดในทีเดียวไม่ได้อีก
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 1);
      allow create, delete: if isAdmin();
      // usedCount ถูกอ่านอย่างเดียวฝั่ง client — การเพิ่มต้องทำผ่าน Admin SDK
      // เดิมผู้ใช้ที่ล็อกอินเพิ่ม usedCount ของคูปองใบไหนก็ได้ (เผาคูปองทิ้ง)
      allow update: if isAdmin();
    }

    match /gpCoupons/{couponId} {
      // ใช้งานจากแอป admin เท่านั้น (lawyers/[id], gp-coupons) — เดิมเปิดอ่านสาธารณะ
      allow read, list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // --- B2B & CLM Rules ---

    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid || 
        request.auth.uid in resource.data.get('adminUids', []) ||
        isAdmin()
      );
      // ไล่ดูทุก repo แล้วไม่มี client ตัวไหนเขียน companies — เดิมเจ้าของแก้ได้ทุกฟิลด์
      // (รวม adminUids ที่ใช้ให้สิทธิ์อ่านด้านบน และข้อมูลแพ็กเกจของบริษัท) ปิดเป็นแอดมิน/Admin SDK
      allow create, update: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.lawyer_id ||
        request.auth.uid == resource.data.lawyerId ||
        isAdmin()
      );
      // เดิม `allow create: if isSignedIn()` = ใครก็สร้างใบแจ้งหนี้ยอดเท่าไหร่ก็ได้
      // และ update ให้คู่กรณีในใบแจ้งหนี้แก้เอกสารตัวเองได้ รวมถึงยอดและสถานะจ่าย
      // ใบแจ้งหนี้จริงออกจาก server action (Lawslane/src/app/actions/billing-actions.ts)
      // ด้วย Admin SDK ซึ่งข้ามกฎนี้ ฝั่ง client อ่านอย่างเดียว ตรวจแล้ว 2026-09-22
      allow create, update, delete: if isAdmin();
    }

    // เดิมไม่มี rule ของ collection นี้เลย → ตกไปโดน "default deny" ท้ายไฟล์เสมอ
    // ทำให้ getCaseById() (lib/data.ts, อ่านผ่าน client SDK) ยิง permission-denied ทุกครั้ง
    // แล้วถูก catch เป็น "ไม่พบเคส" (404) ทั้งที่เคสมีอยู่จริง — เพิ่ง noticed ตอนต่อฟีเจอร์
    // พยานหลักฐาน/พยานบุคคลที่ /lawyer-dashboard/case/[id] ซึ่งอ่านหน้านี้เป็นทางเข้าเดียว
    // เขียน/แก้ทุกอย่างผ่าน server action เท่านั้น (lawyer-case-actions.ts ใช้ Admin SDK
    // ซึ่งข้าม rules อยู่แล้ว) จึงปิด create/update/delete จาก client ไปเลย
    match /legalCases/{caseId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.lawyer_id ||
        request.auth.uid == resource.data.get('client_id', '') ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /contracts/{contractId} {
      function canAccessContract() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        let hasUserDoc = exists(userDocPath);
        let userDoc = hasUserDoc ? get(userDocPath).data : {};
        let userCompanyId = hasUserDoc ? userDoc.get('companyId', null) : null;
        let resourceCompanyId = resource.data.get('companyId', null);
        
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.client_id ||
          request.auth.uid == resource.data.lawyerId ||
          request.auth.uid == resource.data.lawyer_id ||
          (resourceCompanyId != null && userCompanyId != null && resourceCompanyId == userCompanyId) ||
          isAdmin()
        );
      }

      allow read: if canAccessContract();
      allow create: if isSignedIn();
      allow update: if canAccessContract();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /compliance_events/{eventId} {
      function canAccessCompliance() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        let hasUserDoc = exists(userDocPath);
        let userDoc = hasUserDoc ? get(userDocPath).data : {};
        let userCompanyId = hasUserDoc ? userDoc.get('companyId', null) : null;
        let resourceCompanyId = resource.data.get('companyId', null);
        
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          (resourceCompanyId != null && userCompanyId != null && resourceCompanyId == userCompanyId) ||
          isAdmin()
        );
      }

      allow read: if canAccessCompliance();
      // ไม่มี client ตัวไหนเขียน (business overview อ่านอย่างเดียว) — เดิม update ได้ทุกฟิลด์
      // รวมถึง ownerId / companyId ที่ใช้ตัดสินสิทธิ์อ่าน
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /cap-deals/{dealId} {
      function canAccessDeal() {
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid == resource.data.userId ||
          isAdmin()
        );
      }
      allow get, list: if canAccessDeal();
      // เขียนได้เฉพาะแอดมิน — ทุก mutation จริงไปทาง Admin SDK อยู่แล้ว
      // (capdeal: app/actions/finance-actions.ts, api/admin/finance) ซึ่งข้ามกฎนี้
      // ไม่มี client ตัวไหนเขียน cap-deals เลย ตรวจแล้ว 2026-09-22
      //
      // เดิม `allow update, delete: if canAccessDeal()` = เจ้าของดีลแก้ status
      // การเงินของตัวเองได้ (เช่น ตั้ง status: 'active' เองโดยไม่ต้องจ่าย)
      allow create, update, delete: if isAdmin();
    }

    // `bookOrders` retired 2026-09-21 — collection is empty in production and no app
    // reads/writes it anymore (education writes real store orders to `orders` below;
    // lawslane-admin and the main dashboard were switched to read `orders` too).
    // See LAWSLANE-PLAN-03 §A.2.

    // แบบสอบถามสาธารณะ (ไม่ต้องล็อกอินโดยตั้งใจ) — survey-lawyer/page.tsx เขียน
    // { answers, stoppedEarly, createdAt } เท่านั้น
    match /survey_lawyer_responses/{responseId} {
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['answers', 'stoppedEarly', 'createdAt'])
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 100
          && request.resource.data.createdAt == request.time
        );
        allow read, update, delete: if isAdmin();
    }

    // survey-public/page.tsx เขียน { answers, createdAt }
    match /survey_public_responses/{responseId} {
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['answers', 'createdAt'])
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 100
          && request.resource.data.createdAt == request.time
        );
        allow read, update, delete: if isAdmin();
    }

    // unified-survey-form.tsx (business-landing) เขียน { ...values ของ zod schema, createdAt }
    match /unified_surveys/{responseId} {
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly([
            'respondentName', 'role', 'businessType', 'businessTypeOther', 'businessSize',
            'businessDuration', 'contractVolume', 'challenges', 'challengesOther', 'currentTool',
            'initialHandling', 'aiExpectation', 'aiTimeSaved', 'aiConcerns', 'preferredChannel',
            'hiringObstacles', 'confidenceFactor', 'outsourceInterest', 'subscriptionInterest',
            'consent', 'createdAt'])
          && request.resource.data.createdAt == request.time
        );
        allow read, update, delete: if isAdmin();
    }

    // ไม่มี repo ไหนเขียนแล้ว
    match /b2b_survey_responses/{responseId} {
        allow create: if isAdmin();
        allow read, update, delete: if isAdmin();
    }

    // ไม่มี repo ไหนเขียนแล้ว
    match /sme_survey_responses/{responseId} {
        allow create: if isAdmin();
        allow read, update, delete: if isAdmin();
    }

    // ─── Exam System ──────────────────────────────────────────────
    match /examSets/{examSetId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();

        match /questions/{questionId} {
            allow read: if isSignedIn();
            allow write: if isAdmin();
        }
    }

    match /examAttempts/{attemptId} {
        // ไล่ดูทุก repo แล้วไม่มี client ตัวไหนเขียน examAttempts (lawlanes-education อ่านผ่าน
        // api/education/attempts ด้วย Admin SDK) — เดิมเจ้าของสร้าง/แก้คะแนนของตัวเองได้ทุกฟิลด์
        allow create, update: if isAdmin();
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow delete: if isAdmin();
    }

    match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /orders/{orderId} {
        // คำสั่งซื้อสร้างผ่าน api/education/orders (Admin SDK) ซึ่งคิดราคาเองฝั่ง server
        // เดิม client สร้างเองได้แค่ใส่ userId ตัวเอง → ยิง { status: 'paid', total: 0 } แล้ว
        // my-ebooks (อ่าน orders ที่จ่ายแล้ว) ก็ปลดล็อกหนังสือให้ ไม่มี client ตัวไหนเขียน orders
        allow create: if isAdmin();
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.userId) ||
          isAdmin()
        );
        allow update: if isAdmin();
    }

    // AI response cache — ใช้จาก server เท่านั้น (lib/ai-cache.ts ผ่าน Admin SDK)
    // เดิม `allow read, write: if true` ให้ client SDK ฝั่ง server ที่ไม่ได้ล็อกอินใช้ได้
    // → ใครก็เขียนทับ "คำตอบกฎหมาย" ในแคช (key = sha256 ของคำถาม คำนวณเองได้) ให้คนถัดไปเห็น
    // → ใครก็อ่านได้ ทั้งที่เอกสารเก็บ input 500 ตัวอักษรแรก (เช่น เนื้อหาสัญญาที่ส่งมาวิเคราะห์)
    match /ai_cache/{cacheKey} {
        allow read, write: if false;
    }

    // Site statistics (page views)
    match /siteStats/{docId} {
        // เดิมเป็น `allow read, write: if true` ทั้งเอกสารหลักและ shards
        // → ใครก็เขียน document อะไรก็ได้ลงไป โดยไม่ต้องล็อกอินด้วยซ้ำ
        //
        // การนับ page view เขียนจากฝั่ง client จริง (lib/data.ts incrementPageView)
        // จึงยังปิดสนิทไม่ได้ แต่จำกัด "รูปร่าง" ของการเขียนให้ทำได้แค่แบบที่ตัวนับใช้
        // เอกสารแม่ (siteStats/pageViews, siteStats/pageViews_shards) มีแต่การอ่าน
        // → ปิดการเขียนได้เลย
        //
        // TODO: ย้ายการนับไปฝั่ง server แล้วเปลี่ยน shards เป็น write:false
        //       (ตรงกับ LAWSLANE-PLAN-01 1.5 ที่จะเลิกเขียน Firestore ทุก page view)
        allow read: if true;
        allow write: if false;

        match /shards/{shardId} {
            allow read: if true;
            // shard ใหม่: มีได้ฟิลด์เดียว (คีย์เดือนปัจจุบัน)
            allow create: if request.resource.data.keys().size() == 1;
            // อัปเดต: แตะได้ทีละฟิลด์เดียวเท่านั้น (increment ของเดือนเดียว)
            // กันการถมฟิลด์ขยะหรือเขียนทับทั้งเอกสารรวดเดียว
            allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1;
            allow delete: if isAdmin();
        }
    }

    // Telemetry ของเคส — เขียนได้จาก Admin SDK เท่านั้น (ซึ่งข้าม rules อยู่แล้ว)
    // ฝั่ง client เขียนไม่ได้เด็ดขาด เพื่อไม่ให้ปั่นตัวเลขที่ใช้จัดอันดับทนาย
    // เอกสารในนี้ไม่มี PII เลย (ดู src/lib/telemetry/case-events.ts)
    match /caseEvents/{eventId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // metric สรุปรายทนาย — ทนายต้องดูของตัวเองได้ ไม่งั้น incentive มองไม่เห็น
    // = กลไกไม่ทำงาน แต่ห้ามดูของคนอื่น และ offPlatformIndex อยู่ในนี้เท่านั้น
    // ห้าม mirror ขึ้น lawyerProfiles
    match /lawyerMetrics/{lawyerId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow write: if false;
    }

    // ─── ล่ามทนาย (Legal Interpreter) ─────────────────────────────────
    // เขียนทั้งหมดผ่าน Admin SDK (src/app/actions/interpreter-*-actions.ts และ lawslane-admin)
    // ซึ่งบังคับสถานะ/ราคา/GP ฝั่ง server — client เขียนตรงไม่ได้เลย
    // หน้าสาธารณะอ่านผ่าน getApprovedInterpretersAction (allowlist) จึงไม่เปิด list
    match /interpreterProfiles/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow write: if isAdmin();

      // ข้อมูลติดต่อ เอกสาร บัญชีรับเงิน
      match /private/{docId} {
        allow read: if isAdmin() || isOwner(uid);
        allow write: if isAdmin();
      }
    }

    // มีที่อยู่/รายละเอียดงานของลูกค้า — อ่านได้เฉพาะคู่กรณี
    match /interpreterBookings/{bookingId} {
      allow get, list: if isAdmin() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.interpreterId == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    // ตัวล็อกเวลากันจองชน — ใช้ใน transaction ฝั่ง server เท่านั้น
    match /interpreterSlots/{slotId} {
      allow read, write: if isAdmin();
    }

    // แชทลูกค้า↔ล่าม + ใบเสนอราคา — อ่าน/เขียนผ่าน server action เท่านั้น
    // (ต้นฉบับข้อความที่ถูกปิดข้อมูลติดต่อเก็บอยู่ในนี้ ห้ามให้คู่สนทนาอ่านตรง)
    match /interpreterConversations/{conversationId}/{document=**} {
      allow read, write: if isAdmin();
    }
    match /interpreterConversations/{conversationId} {
      allow read, write: if isAdmin();
    }

    // ข้อมูลติดต่อลูกค้าของแต่ละงาน — ล่ามเห็นผ่าน server action หลังจ่ายเงินแล้วเท่านั้น
    match /interpreterBookings/{bookingId}/private/{docId} {
      allow read, write: if isAdmin();
    }

    match /interpreterPayouts/{payoutId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.interpreterId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Default deny at the very end
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
        // Custom claim is the source of truth (see scripts/set-admin-claim.js).
        // The hardcoded UIDs/emails are carried over from lawslane-admin's rules
        // as a safety net during rules consolidation — remove once every admin
        // account is confirmed to have the custom claim set (see LAWSLANE-PLAN-01 Phase 4).
        return isSignedIn() && (
          request.auth.token.admin == true ||
          request.auth.uid == 'wS9w7ysNYUajNsBYZ6C7n2Afe9H3' ||
          request.auth.token.email == 'lek.26015@gmail.com' ||
          request.auth.uid == '6rX3WqjNo9M7lX6iUe5V9r7Dk9z1' ||
          request.auth.token.email == 'admin@lawslane.com'
        );
    }

    match /users/{userId} {
      // ฟิลด์ที่ผู้ใช้ห้ามเขียนให้ตัวเอง — เป็นสิทธิ์ / ความเป็นเจ้าของ / สถานะการเงิน
      // เดิมกฎเป็น `allow write: if isOwner(userId)` เฉยๆ ไม่จำกัดฟิลด์เลย แปลว่า
      // ใครก็เปิด console แล้ว updateDoc(users/<uid ตัวเอง>, {role:'admin'}) ได้
      // และตั้ง companyId เป็นของบริษัทอื่นเพื่ออ่าน/แก้สัญญาของบริษัทนั้นได้ด้วย
      // (ดู canAccessContract() และ canAccessCompliance() ด้านล่าง)
      function privilegedUserFields() {
        return [
          'role', 'superAdmin', 'permissions', 'adminPermissions',
          'companyId', 'subscription', 'balance', 'credits',
          'isVerified', 'verified', 'emailVerified'
        ];
      }

      // ตอนสมัครสมาชิก ฝั่ง client เขียน role มาด้วย (signup-content.tsx, lawyer-signup)
      // จึงอนุญาตเฉพาะค่าที่ไม่ใช่สิทธิ์พิเศษ — ห้าม 'admin' เด็ดขาด
      function createsSafeRole() {
        return !('role' in request.resource.data.keys())
          || request.resource.data.role in ['customer', 'lawyer', 'education_student'];
      }

      function createsNoOtherPrivilegedField() {
        return !request.resource.data.keys().hasAny(
          ['superAdmin', 'permissions', 'adminPermissions', 'companyId',
           'subscription', 'balance', 'credits', 'isVerified', 'verified']
        );
      }

      allow read: if isSignedIn();

      allow create: if isAdmin()
        || (isOwner(userId) && createsSafeRole() && createsNoOtherPrivilegedField());

      // อัปเดตโปรไฟล์ของตัวเองได้ แต่ห้ามแตะฟิลด์สิทธิ์ — การเปลี่ยน role/companyId
      // ต้องทำผ่าน Admin SDK ฝั่ง server เท่านั้น
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(privilegedUserFields()));

      allow delete: if isAdmin();

      match /integrations/{integrationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /lawyerProfiles/{lawyerId} {
      allow read, list: if true;
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      // averageRating/reviewCount ถูกคำนวณและเขียนโดย submitReviewAction ผ่าน Admin SDK
      // (ซึ่งข้าม rules อยู่แล้ว) จึงไม่ต้องเปิดช่องให้ client เขียน
      // เดิมข้อยกเว้นนี้ทำให้ใครที่ล็อกอินก็ปั่นเรตติ้งของทนายคนไหนก็ได้
      allow update: if isOwner(lawyerId) || isAdmin();
      allow delete: if isOwner(lawyerId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      
      allow get: if isSignedIn() && (isParticipant() || isAdmin()); 
      allow list: if isSignedIn() && (
        (request.query.limit <= 1000 && request.auth.uid in request.query.filters.participants) || 
        isAdmin()
      ); 
      // เดิม `allow create: if isSignedIn()` → เปิด console ยิง SDK สร้างเคสพร้อม
      // `amount: 50000, status: 'paid'` ได้โดยไม่ต้องจ่ายอะไรเลย ทนายเห็นว่าเคส
      // จ่ายแล้วและลงมือทำงานฟรี
      //
      // ตอนนี้ทุกห้องสร้างผ่าน Admin SDK: createConsultationChat() (Lawslane, capdeal)
      // และ respondToAppointmentRequestAction() (Lawslane) ไล่ดูทุก repo ที่ใช้
      // Firebase project นี้แล้ว ไม่มี client ตัวไหนสร้าง chats เหลือ
      // (ensureChatExists ใน chat-box.tsx และหน้ารับเคสของ repo สำเนาถูกถอดแล้ว)
      allow create: if isAdmin();

      // ฟิลด์ที่ "แปลว่ามีเงินเข้าแล้ว" หรือกำหนดว่าต้องจ่ายเท่าไร — client ห้ามแตะ
      // เดิมกฎเป็น `isParticipant()` เฉยๆ → ปิดทาง create แล้วก็ยังเปิด console
      // updateDoc(chats/{id}, { status: 'active', paidAmount: 50000 }) กับห้องที่
      // ตัวเองอยู่ได้อยู่ดี ไล่ดูทุก repo แล้ว client แก้แค่ lastMessage / lastMessageAt /
      // hasNewMessage / lawyerReadAt / files — ฟิลด์เงินทั้งหมดเขียนผ่าน Admin SDK
      function moneyFields() {
        return [
          'amount', 'originalFee', 'discount', 'quotedAmount',
          'paidAmount', 'totalPaid', 'installments', 'paidInstallments',
          'status', 'paidAt', 'lastPaymentAt',
          'slipUrl', 'slipOkData', 'pendingPaymentDetails', 'pendingFeeRequest',
          'couponCode', 'couponId', 'hasNewPayment',
          'participants', 'userId', 'lawyerId'
        ];
      }

      allow update: if isAdmin() || (
        isParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(moneyFields())
      );

      match /messages/{messageId} {
        function isChatParticipant() {
          return exists(/databases/$(database)/documents/chats/$(chatId)) &&
                 request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow get, list: if isChatParticipant() || isAdmin();
        // เดิมเช็คแค่ senderId == uid ของตัวเอง แต่ไม่ได้เรียก isChatParticipant()
        // (นิยามไว้ข้างบนแต่ใช้แค่ตอนอ่าน) → รู้ chatId ก็แทรกข้อความเข้าแชทคนอื่นได้
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isChatParticipant() || isAdmin());
        allow update, delete: if false;
      }
    }
    
    match /articles/{articleId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /articleComments/{commentId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ads/{adId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
        // เดิม `allow create: if isSignedIn()` → ใครก็เปิด console ยิง SDK สร้าง
        // นัดหมายพร้อม `amount: 0, status: 'paid'` ได้โดยไม่ต้องผ่านหน้าเว็บ
        // ทนายก็เห็นว่าจ่ายแล้วและลงมือทำงานฟรี
        //
        // ตอนนี้นัดหมายสร้างผ่าน createAppointment() ฝั่ง server ทั้งใน Lawslane
        // และ lawslane-capdeal ซึ่งคิดยอดใหม่เองและตั้งสถานะจากผลตรวจสลิปจริง
        // (ไล่ดูแล้วว่าไม่มี client ตัวไหนเหลือสร้าง appointments อีก — repo อื่น
        //  แตะแค่ update สถานะของนัดหมายที่มีอยู่)
        allow create: if isAdmin();
        // Allow read if user is involved or admin
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.lawyerId == request.auth.uid || isAdmin());
        // Allow list only if the query is properly filtered by the user's role/id
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && (request.auth.uid in request.query.filters.userId || request.auth.uid in request.query.filters.lawyerId)) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.lawyerId == request.auth.uid || isAdmin());
    }

    match /tickets/{ticketId} {
        allow create: if isSignedIn();
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.userId) ||
          isAdmin()
        );
        allow update: if isOwner(resource.data.userId) || isAdmin();

        match /messages/{messageId} {
            allow read, list: if isAdmin() || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId);
            // เดิมเป็น isSignedIn() เฉยๆ → ใครก็ตอบเข้าตั๋วซัพพอร์ตของคนอื่นได้
            allow create: if isAdmin()
              || (isSignedIn()
                  && request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId);
        }
    }

    // ผลตรวจสลิปจาก SlipOK ที่ server เก็บไว้ (ดู api/verify-slip/route.ts)
    // เป็นหลักฐานว่า "จ่ายจริงแล้ว" client ห้ามอ่านหรือเขียนทั้งหมด — เขียนและ
    // ใช้ผ่าน Admin SDK เท่านั้น ไม่งั้นก็ปลอมเอกสารแล้วอ้างว่าจ่ายแล้วได้เหมือนเดิม
    match /slipVerifications/{verificationId} {
        allow read, write: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
        // เส้นทางเดียวในระบบที่เงินสดออกจากบริษัทจริง — เขียนผ่าน Admin SDK เท่านั้น
        //
        // กฎเดิมคือ `allow create: if isSignedIn() && lawyerId == request.auth.uid`
        // ซึ่งตรวจแค่ว่าเป็นเจ้าของ **ไม่ตรวจยอดเลย** การตรวจยอดอยู่ในเบราว์เซอร์
        // (`amount > stats.availableBalance`) อย่างเดียว → ทนายที่มีรายได้ ฿0
        // เปิด console ยิง SDK ขอถอน ฿500,000 ได้ทันที
        //
        // ตอนนี้คำร้องสร้างผ่าน requestWithdrawal() (Lawslane/src/app/actions/
        // withdrawal-actions.ts) ที่คิดยอดใหม่ฝั่ง server และการอนุมัติผ่าน
        // processWithdrawal() (lawslane-admin) ที่คิดซ้ำก่อนเปลี่ยนสถานะ
        // ไม่มี client ตัวไหนต้องเขียนคอลเลกชันนี้อีกแล้ว
        allow create, update, delete: if isAdmin();
        allow get: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.lawyerId) ||
          isAdmin()
        );
    }

    match /sme_inquiries/{inquiryId} {
        allow create: if true; // Public contact form
        allow read, update, delete: if isAdmin();
    }

    match /email_logs/{logId} {
        allow read, write: if isAdmin();
    }
    match /notifications/{notificationId} {
        allow create: if isSignedIn();
        allow get: if isSignedIn() && (resource.data.recipient == request.auth.uid || resource.data.recipient == 'admin' || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.recipient == request.auth.uid ||
          (resource.data.recipient == 'admin' && isAdmin()) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (resource.data.recipient == request.auth.uid || isAdmin());
    }
    match /landingPages/{pageId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }
    
    match /verifiedLawyers/{lawyerId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /siteContent/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /contractRequests/{requestId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /registrationRequests/{requestId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /smeRequests/{requestId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /legalForms/{formId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']));
    }

    match /settings/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // เดิม `allow read, list: if true` → ใครก็กวาดโค้ดส่วนลดทุกใบพร้อมส่วนลดได้
      //
      // หน้า payment ตรวจคูปองฝั่ง client ด้วย
      //   where('code','==',X) + where('isActive','==',true) + limit(1)
      // จึงยังต้องให้ query ได้ แต่บังคับ limit <= 1 เพื่อให้ "ต้องรู้โค้ดก่อน"
      // ไล่ดึงรายการทั้งหมดในทีเดียวไม่ได้อีก
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 1);
      allow create, delete: if isAdmin();
      // usedCount ถูกอ่านอย่างเดียวฝั่ง client — การเพิ่มต้องทำผ่าน Admin SDK
      // เดิมผู้ใช้ที่ล็อกอินเพิ่ม usedCount ของคูปองใบไหนก็ได้ (เผาคูปองทิ้ง)
      allow update: if isAdmin();
    }

    match /gpCoupons/{couponId} {
      // ใช้งานจากแอป admin เท่านั้น (lawyers/[id], gp-coupons) — เดิมเปิดอ่านสาธารณะ
      allow read, list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // --- B2B & CLM Rules ---

    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid || 
        request.auth.uid in resource.data.get('adminUids', []) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid || 
        isAdmin()
      );
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.lawyer_id ||
        request.auth.uid == resource.data.lawyerId ||
        isAdmin()
      );
      // เดิม `allow create: if isSignedIn()` = ใครก็สร้างใบแจ้งหนี้ยอดเท่าไหร่ก็ได้
      // และ update ให้คู่กรณีในใบแจ้งหนี้แก้เอกสารตัวเองได้ รวมถึงยอดและสถานะจ่าย
      // ใบแจ้งหนี้จริงออกจาก server action (Lawslane/src/app/actions/billing-actions.ts)
      // ด้วย Admin SDK ซึ่งข้ามกฎนี้ ฝั่ง client อ่านอย่างเดียว ตรวจแล้ว 2026-09-22
      allow create, update, delete: if isAdmin();
    }

    // เดิมไม่มี rule ของ collection นี้เลย → ตกไปโดน "default deny" ท้ายไฟล์เสมอ
    // ทำให้ getCaseById() (lib/data.ts, อ่านผ่าน client SDK) ยิง permission-denied ทุกครั้ง
    // แล้วถูก catch เป็น "ไม่พบเคส" (404) ทั้งที่เคสมีอยู่จริง — เพิ่ง noticed ตอนต่อฟีเจอร์
    // พยานหลักฐาน/พยานบุคคลที่ /lawyer-dashboard/case/[id] ซึ่งอ่านหน้านี้เป็นทางเข้าเดียว
    // เขียน/แก้ทุกอย่างผ่าน server action เท่านั้น (lawyer-case-actions.ts ใช้ Admin SDK
    // ซึ่งข้าม rules อยู่แล้ว) จึงปิด create/update/delete จาก client ไปเลย
    match /legalCases/{caseId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.lawyer_id ||
        request.auth.uid == resource.data.get('client_id', '') ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /contracts/{contractId} {
      function canAccessContract() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        let hasUserDoc = exists(userDocPath);
        let userDoc = hasUserDoc ? get(userDocPath).data : {};
        let userCompanyId = hasUserDoc ? userDoc.get('companyId', null) : null;
        let resourceCompanyId = resource.data.get('companyId', null);
        
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.client_id ||
          request.auth.uid == resource.data.lawyerId ||
          request.auth.uid == resource.data.lawyer_id ||
          (resourceCompanyId != null && userCompanyId != null && resourceCompanyId == userCompanyId) ||
          isAdmin()
        );
      }

      allow read: if canAccessContract();
      allow create: if isSignedIn();
      allow update: if canAccessContract();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /compliance_events/{eventId} {
      function canAccessCompliance() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        let hasUserDoc = exists(userDocPath);
        let userDoc = hasUserDoc ? get(userDocPath).data : {};
        let userCompanyId = hasUserDoc ? userDoc.get('companyId', null) : null;
        let resourceCompanyId = resource.data.get('companyId', null);
        
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          (resourceCompanyId != null && userCompanyId != null && resourceCompanyId == userCompanyId) ||
          isAdmin()
        );
      }

      allow read: if canAccessCompliance();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canAccessCompliance();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /cap-deals/{dealId} {
      function canAccessDeal() {
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid == resource.data.userId ||
          isAdmin()
        );
      }
      allow get, list: if canAccessDeal();
      // เขียนได้เฉพาะแอดมิน — ทุก mutation จริงไปทาง Admin SDK อยู่แล้ว
      // (capdeal: app/actions/finance-actions.ts, api/admin/finance) ซึ่งข้ามกฎนี้
      // ไม่มี client ตัวไหนเขียน cap-deals เลย ตรวจแล้ว 2026-09-22
      //
      // เดิม `allow update, delete: if canAccessDeal()` = เจ้าของดีลแก้ status
      // การเงินของตัวเองได้ (เช่น ตั้ง status: 'active' เองโดยไม่ต้องจ่าย)
      allow create, update, delete: if isAdmin();
    }

    // `bookOrders` retired 2026-09-21 — collection is empty in production and no app
    // reads/writes it anymore (education writes real store orders to `orders` below;
    // lawslane-admin and the main dashboard were switched to read `orders` too).
    // See LAWSLANE-PLAN-03 §A.2.

    match /survey_lawyer_responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /survey_public_responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /unified_surveys/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /b2b_survey_responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /sme_survey_responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    // ─── Exam System ──────────────────────────────────────────────
    match /examSets/{examSetId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();

        match /questions/{questionId} {
            allow read: if isSignedIn();
            allow write: if isAdmin();
        }
    }

    match /examAttempts/{attemptId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if isAdmin();
    }

    match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /orders/{orderId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.userId) ||
          isAdmin()
        );
        allow update: if isAdmin();
    }

    // AI response cache (server-only; hashed keys, no user-identifying data).
    // Was previously falling through to the default-deny rule below, meaning every
    // getCachedAIResponse/setCachedAIResponse call silently failed — the AI flows'
    // caching never actually worked regardless of call ordering. See LAWSLANE-PLAN-01 2.7.
    match /ai_cache/{cacheKey} {
        allow read, write: if true;
    }

    // Site statistics (page views)
    match /siteStats/{docId} {
        // เดิมเป็น `allow read, write: if true` ทั้งเอกสารหลักและ shards
        // → ใครก็เขียน document อะไรก็ได้ลงไป โดยไม่ต้องล็อกอินด้วยซ้ำ
        //
        // การนับ page view เขียนจากฝั่ง client จริง (lib/data.ts incrementPageView)
        // จึงยังปิดสนิทไม่ได้ แต่จำกัด "รูปร่าง" ของการเขียนให้ทำได้แค่แบบที่ตัวนับใช้
        // เอกสารแม่ (siteStats/pageViews, siteStats/pageViews_shards) มีแต่การอ่าน
        // → ปิดการเขียนได้เลย
        //
        // TODO: ย้ายการนับไปฝั่ง server แล้วเปลี่ยน shards เป็น write:false
        //       (ตรงกับ LAWSLANE-PLAN-01 1.5 ที่จะเลิกเขียน Firestore ทุก page view)
        allow read: if true;
        allow write: if false;

        match /shards/{shardId} {
            allow read: if true;
            // shard ใหม่: มีได้ฟิลด์เดียว (คีย์เดือนปัจจุบัน)
            allow create: if request.resource.data.keys().size() == 1;
            // อัปเดต: แตะได้ทีละฟิลด์เดียวเท่านั้น (increment ของเดือนเดียว)
            // กันการถมฟิลด์ขยะหรือเขียนทับทั้งเอกสารรวดเดียว
            allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1;
            allow delete: if isAdmin();
        }
    }

    // Default deny at the very end
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

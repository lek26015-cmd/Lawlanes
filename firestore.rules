
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
        return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /integrations/{integrationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /lawyerProfiles/{lawyerId} {
      allow read, list: if true;
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isOwner(lawyerId) || isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount']));
      allow delete: if isOwner(lawyerId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      
      allow get: if isSignedIn() && (isParticipant() || isAdmin()); 
      allow list: if isSignedIn() && (
        (request.query.limit <= 1000 && request.auth.uid in request.query.filters.participants) || 
        isAdmin()
      ); 
      allow create: if isSignedIn();
      allow update: if isParticipant() || isAdmin();

      match /messages/{messageId} {
        function isChatParticipant() {
          return exists(/databases/$(database)/documents/chats/$(chatId)) &&
                 request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow get, list: if isChatParticipant() || isAdmin();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    
    match /articles/{articleId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /ads/{adId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
        allow create: if isSignedIn();
        // Allow read if user is involved or admin
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.lawyerId == request.auth.uid || isAdmin());
        // Allow list only if the query is properly filtered by the user's role/id
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && (request.auth.uid in request.query.filters.userId || request.auth.uid in request.query.filters.lawyerId)) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.lawyerId == request.auth.uid || isAdmin());
    }

    match /tickets/{ticketId} {
        allow create: if isSignedIn();
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.userId) ||
          isAdmin()
        );
        allow update: if isOwner(resource.data.userId) || isAdmin();

        match /messages/{messageId} {
            allow read, list: if isAdmin() || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId);
            allow create: if isSignedIn();
        }
    }

    match /withdrawals/{withdrawalId} {
        allow create: if isSignedIn() && request.resource.data.lawyerId == request.auth.uid;
        allow get: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (
          (request.query.limit <= 1000 && request.auth.uid in request.query.filters.lawyerId) ||
          isAdmin()
        );
        allow update: if isAdmin(); // Only admins can process withdrawals
    }

    match /sme_inquiries/{inquiryId} {
        allow create: if true; // Public contact form
        allow read, update, delete: if isAdmin();
    }

    match /email_logs/{logId} {
        allow read, write: if isAdmin();
    }
    match /notifications/{notificationId} {
        allow create: if isSignedIn();
        allow get: if isSignedIn() && (resource.data.recipient == request.auth.uid || resource.data.recipient == 'admin' || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.recipient == request.auth.uid ||
          (resource.data.recipient == 'admin' && isAdmin()) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (resource.data.recipient == request.auth.uid || isAdmin());
    }
    match /landingPages/{pageId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }
    
    match /verifiedLawyers/{lawyerId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /siteContent/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /contractRequests/{requestId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /registrationRequests/{requestId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /smeRequests/{requestId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /legalForms/{formId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']));
    }

    match /settings/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, list: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']));
    }

    match /gpCoupons/{couponId} {
      allow read, list: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // --- B2B & CLM Rules ---

    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid || 
        request.auth.uid in resource.data.get('adminUids', []) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid || 
        isAdmin()
      );
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.lawyer_id ||
        request.auth.uid == resource.data.lawyerId ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.client_id ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.lawyer_id ||
        request.auth.uid == resource.data.lawyerId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      function canAccessContract() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        let hasUserDoc = exists(userDocPath);
        let userDoc = hasUserDoc ? get(userDocPath).data : {};
        let userCompanyId = hasUserDoc ? userDoc.get('companyId', null) : null;
        let resourceCompanyId = resource.data.get('companyId', null);
        
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.client_id ||
          request.auth.uid == resource.data.lawyerId ||
          request.auth.uid == resource.data.lawyer_id ||
          (resourceCompanyId != null && userCompanyId != null && resourceCompanyId == userCompanyId) ||
          isAdmin()
        );
      }

      allow read: if canAccessContract();
      allow create: if isSignedIn();
      allow update: if canAccessContract();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /compliance_events/{eventId} {
      function canAccessCompliance() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        let hasUserDoc = exists(userDocPath);
        let userDoc = hasUserDoc ? get(userDocPath).data : {};
        let userCompanyId = hasUserDoc ? userDoc.get('companyId', null) : null;
        let resourceCompanyId = resource.data.get('companyId', null);
        
        return isSignedIn() && (
          request.auth.uid == resource.data.ownerId ||
          (resourceCompanyId != null && userCompanyId != null && resourceCompanyId == userCompanyId) ||
          isAdmin()
        );
      }

      allow read: if canAccessCompliance();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canAccessCompliance();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /bookOrders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Use get and list for more granular control
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        (request.query.limit <= 1000 && request.auth.uid in request.query.filters.userId) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Default deny at the very end
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

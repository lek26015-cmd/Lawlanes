# Template for a separate Firebase project used only in local development,
# so `npm run dev` never reads/writes production data.
# See LAWSLANE-PLAN-01 (0.3).
#
# This project has never had a dev project — creating one is a manual,
# account-level step (billing lives on tawanberkfah's Firebase account), so it
# isn't done automatically. To set one up:
#
#   1. firebase login                              # if not already
#   2. firebase projects:create lawslane-dev        # or pick your own project id
#   3. firebase apps:create web lawslane-dev-web --project lawslane-dev
#   4. In the Firebase console for the new project: enable Firestore, Auth
#      (mirror the sign-in providers enabled on studio-3946808940-28553),
#      and Storage.
#   5. firebase apps:sdkconfig web --project lawslane-dev   # prints the values below
#   6. Generate a service account key for FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY:
#      Firebase console → Project settings → Service accounts → Generate new private key
#   7. Deploy this repo's firestore.rules/firestore.indexes.json/storage.rules to the
#      new project too: firebase deploy --project lawslane-dev --only firestore,storage
#   8. Copy this file to .env.development.local and fill in the values from
#      steps 5-6. Next.js loads .env.development.local automatically for `next dev`
#      (it takes priority over .env.local in development), so nothing else changes.
#
# Until this is set up, `npm run dev` keeps using the values in .env.local,
# which point at the shared production project.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

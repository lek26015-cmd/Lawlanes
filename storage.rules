rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper Functions ───────────────────────────────────────────

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is admin via custom claim
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Check if user is the owner of the resource
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validate file size: max 5MB
    function isValidFileSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    // Validate content type: images and PDFs only
    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    // Combined upload validation
    function isValidUpload() {
      return isValidFileSize() && isImageOrPdf();
    }

    // ─── Lawyer Documents (PRIVATE) ─────────────────────────────────
    // Only the owner lawyer or admins can read/write
    match /lawyer_documents/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin()) && isValidUpload();
    }

    // ─── Public Profiles ────────────────────────────────────────────
    // Anyone can view profile assets, only owner can upload
    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidUpload();
    }

    // ─── Lawyer Profile Images (PUBLIC read) ────────────────────────
    // Public read for lawyer listing pages, owner or admin can write
    match /lawyerProfiles/{lawyerId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(lawyerId) || isAdmin()) && isValidUpload();
    }

    // ─── Articles, Ads, Public Assets (Admin-managed) ───────────────
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidUpload();
    }

    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidUpload();
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidUpload();
    }

    // ─── Chat Attachments (SCOPED to participant) ───────────────────
    // Files stored as /chats/{chatId}/{senderUid}/filename
    // Only the sender can upload to their own subfolder; any participant can read
    match /chats/{chatId}/{senderUid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(senderUid) && isValidUpload();
    }

    // ─── Contract Files (SCOPED to owner) ───────────────────────────
    // Files stored as /contracts/{ownerUid}/filename
    // Owner can read/write their own contracts; admins can access all
    match /contracts/{ownerUid}/{allPaths=**} {
      allow read: if isOwner(ownerUid) || isAdmin();
      allow write: if (isOwner(ownerUid) || isAdmin()) && isValidUpload();
    }

    // ─── User Uploads (profile pics, etc.) ──────────────────────────
    // Public read (for avatars), only owner can write
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidUpload();
    }

    // ─── B2B Company Vault (SCOPED to member) ───────────────────────
    // Files stored as /companies/{companyId}/vault/{memberUid}/filename
    // Only the uploading member can write to their subfolder
    // Any company member (authenticated) can read; admin can access all
    match /companies/{companyId}/vault/{memberUid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(memberUid) && isValidUpload();
      allow delete: if isOwner(memberUid) || isAdmin();
    }

    // ─── Default: deny everything else ──────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Resend (Email)
RESEND_API_KEY=

# Other
NEXT_PUBLIC_BASE_URL=http://localhost:3000

NEXT_PUBLIC_RAG_WORKER_URL=https://lawslane-rag-api.lawlanes-app.workers.dev

SLIPOK_API_KEY=

INGESTION_STATUS_SECRET=

# แพลนรายเดือนทนาย/ล่าม (Stripe บัญชีเดียวกับ CapDeal) — ราคาตั้งใน Stripe Dashboard แล้วใส่ Price ID
# ใส่ค่าจริงใน env ของ Vercel/App Hosting เท่านั้น (repo เป็น public) · ห้ามมี prefix NEXT_PUBLIC_ · แยก key ของ test กับ live
# STRIPE_SECRET_KEY ต้องเป็น Restricted key (rk_test_… / rk_live_…) ของเว็บนี้ ห้ามใช้ secret key ตัวเต็ม (sk_…)
#   สิทธิ์: Checkout Sessions, Customers, Customer portal = เขียน · Subscriptions = เขียน (ยกเลิกตอนลบบัญชี)
#           Prices, Invoices, Charges = อ่าน · ที่เหลือ = ไม่มีสิทธิ์
STRIPE_SECRET_KEY=
# signing secret (whsec_…) ของ endpoint /api/webhooks/stripe-plans — คนละตัวกับของ CapDeal
STRIPE_PLANS_WEBHOOK_SECRET=
STRIPE_PRICE_LAWYER_PRO=
STRIPE_PRICE_LAWYER_TOP=
STRIPE_PRICE_INTERPRETER_PRO=
STRIPE_PRICE_INTERPRETER_TOP=
# Price เก่าที่ผู้สมัครเดิมยังใช้ (ไม่บังคับ) — คั่นด้วย comma · Price ที่ไม่อยู่ในรายการ = ไม่ให้แพลน
STRIPE_PRICE_LAWYER_PRO_PREVIOUS=
STRIPE_PRICE_LAWYER_TOP_PREVIOUS=
STRIPE_PRICE_INTERPRETER_PRO_PREVIOUS=
STRIPE_PRICE_INTERPRETER_TOP_PREVIOUS=
